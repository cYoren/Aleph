# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Large files
assets/*.db
*.db

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android Signing (NEVER commit these)
android/key.properties
android/*.jks
android/*.keystore
*.jks
*.keystore

# Local API keys. `scripts/_secrets.py` reads OPENROUTER_API_KEY from here when
# it is not in the environment. Never commit this file.
.env
.env.*

# fastlane run artifacts
fastlane/report.xml

# store screenshot raws (regenerate with tool/capture)
tool/capture/raw/
tool/capture/failures/

# Bundled TTS voices: large, redistributable, and NOT committed. Prepare them
# with `python3 scripts/fetch_embedded_voices.py` (pinned URLs + SHA-256), which
# also writes manifest.json. `assets/voices/` is listed in pubspec.yaml so a
# build without them fails loudly instead of shipping a silent app.
assets/voices/
